        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Login {\nusername\npassword\nuserToken\n}\n\nclass Users {\nuserID (PK)\nemail\nrole\nfirstName\nlastName\ndateOfBirth\n}\n\nclass Companies {\ncompanyID (PK)\ncompanyName\ncompanyAddress\ncompanyContact\n}\n\nclass UsersToCompany {\ncompanyID (FK)\nuserID (FK)\n}\n\nclass Products {\nproductID (PK)\nproductName\nproductPrice\nproductDescription\nproductPicture\nproductInventory\ncompanyID (FK)\n}\n\nclass Reviews {\nreviewID (PK)\nrating\ncomment\nuserID (FK)\nproductID (FK)\n}\n\nclass Cart {\ncartID (PK)\nuserID (FK)\n}\n\nclass CartToProducts {\ncartID (FK)\nproductID (FK)\nquantity\n}\n\nclass PaymentInfo {\npaymentID (PK)\ncardNumber\nsecurityCode\naddress\nstate\nzip\nuserID (FK)\n}\n\nclass Orders {\norderID (PK)\nuserID (FK)\norderDate\ntotalCost\nstatus\nshippingAddress\n}\n\nclass OrderItems {\norderItemID (PK)\norderID (FK)\nproductID (FK)\nquantity\npriceAtPurchase\n}\n\nLogin \&quot;1\&quot; --&gt; \&quot;1\&quot; Users : authenticates\n\nUsers \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reviews : writes\nProducts \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reviews : receives\n\nUsers \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Cart : owns\nCart \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CartToProducts : contains\nProducts \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CartToProducts : added to\n\nUsers \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PaymentInfo : has\n\nUsers \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Orders : places\nOrders \&quot;1\&quot; --&gt; \&quot;1..*\&quot; OrderItems : contains\nProducts \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OrderItems : included in\n\nCompanies \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Products : sells\n\nUsers \&quot;1\&quot; --&gt; \&quot;0..*\&quot; UsersToCompany : associated with\nCompanies \&quot;1\&quot; --&gt; \&quot;0..*\&quot; UsersToCompany : has\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="e_vr8f